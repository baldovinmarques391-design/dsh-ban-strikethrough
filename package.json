{
  "name": "dsh-ban-strikethrough",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "禁止渲染删除线：GFM 的单波浪号删除线会把 3~5 这样的区间号吞掉并划一横，本插件在 GUI 与会话文档预览里取消删除线并还原 ~ 字符。",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "bundle-check.mjs",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "markdown",
    "web-ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/baldovinmarques391-design/dsh-ban-strikethrough.git"
  }
}
